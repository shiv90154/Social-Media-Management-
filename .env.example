# =============================================================================
# Social Media Manager — environment configuration
#
# Copy this file to `.env` at the repo root and fill in the values you have.
# Any platform block left blank will show as "Not Configured" in
# Settings -> Developer and will be gracefully disabled in the app (no crash).
# =============================================================================

# --- App / infra -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://smm:smm@localhost:5432/smm?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible media storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=smm_minio_admin
MINIO_SECRET_KEY=smm_minio_password
MINIO_BUCKET=smm-media
MINIO_PUBLIC_URL=http://localhost:9000/smm-media

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Symmetric key used to encrypt SocialAccount access/refresh tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Optional: Google OAuth login (app login, NOT a platform connector)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (via Meta Graph API) -------------------------------------------
# Requires a Meta Developer App with Instagram Graph API product,
# and an Instagram Business/Creator account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# --- Facebook (Meta Graph API - Pages) ----------------------------------------
# Reuses the same Meta Developer App as Instagram (META_APP_ID/META_APP_SECRET).
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback

# --- Threads (Meta) ------------------------------------------------------------
# Reuses the same Meta Developer App; requires separate Threads API permissions.
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# --- X (Twitter) -------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# --- YouTube (Google) --------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# --- TikTok ------------------------------------------------------------------
# Direct Post publishing requires TikTok app audit approval; until approved,
# publishing only reaches your own sandbox/test accounts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# --- Pinterest ----------------------------------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/oauth/pinterest/callback

# --- Snapchat ------------------------------------------------------------------
# NOTE: Snapchat has no public API for unattended/background organic posting.
# These credentials only enable Marketing API analytics / Creative Kit share
# links, not automated publishing. See packages/connectors/src/snapchat.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=http://localhost:3000/api/oauth/snapchat/callback
