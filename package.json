{
  "name": "social-media-manager",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @smm/db run generate",
    "db:migrate": "pnpm --filter @smm/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @smm/db run migrate:deploy",
    "db:studio": "pnpm --filter @smm/db run studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
